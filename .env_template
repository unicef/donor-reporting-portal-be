DJANGO_SETTINGS_MODULE=donor_reporting_portal.config.settings
DATABASE_URL=psql://postgres:pass@127.0.0.1:5432/donor_reporting_portal
SECRET_KEY=
SESSION_COOKIE_SECURE=False
REDIS_URL=redis://redis:6379/1
# Application cache uses REDIS_URL with database /2 unless REDIS_CACHE_URL is set.
REDIS_CACHE_URL=
CACHE_TIMEOUT=300
# Shared Graph cache is off by default; raising this re-enables a cache that is
# not scoped by user permissions.
GRAPH_CACHE_TTL=0
HOST=http://localhost:8082
CELERY_TASK_ALWAYS_EAGER=True
DEBUG=True

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=unicef.org

GRAPH_TENANT=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

AZURE_B2C_CLIENT_ID=
AZURE_B2C_CLIENT_SECRET=
AZURE_B2C_TENANT=

INSIGHT_URL=https://uniapis.azure-api.net/biapi/v1/
INSIGHT_SUB_KEY=

SHAREPOINT_USERNAME=
SHAREPOINT_PASSWORD=
